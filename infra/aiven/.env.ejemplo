# Copiar como infra/aiven/.env (NO se versiona) y completar con los datos de la consola de Aiven.

# ---- Kafka (pestaña Overview del servicio) ----
AIVEN_KAFKA_SERVIDORES=kafka-xxxxxxxx-proyecto.aivencloud.com:12345

# Opción A (por defecto): certificado de cliente. Descargar ca.pem, service.cert y service.key en infra/aiven/certificados/
AIVEN_KAFKA_PROTOCOLO=SSL

# Opción B: SASL/SCRAM (habilitar "kafka_authentication_methods.sasl" en Aiven; usa OTRO puerto en AIVEN_KAFKA_SERVIDORES).
# Solo se necesita ca.pem; dejar vacíos los certificados de cliente.
# AIVEN_KAFKA_PROTOCOLO=SASL_SSL
# AIVEN_KAFKA_MECANISMO=SCRAM-SHA-256
# AIVEN_KAFKA_USUARIO=avnadmin
# AIVEN_KAFKA_CONTRASENA=
# AIVEN_KAFKA_CERTIFICADO_CLIENTE=
# AIVEN_KAFKA_LLAVE_CLIENTE=

# ---- PostgreSQL (pestaña Overview del servicio) ----
AIVEN_PG_HOST=pg-xxxxxxxx-proyecto.aivencloud.com
AIVEN_PG_PUERTO=12345
AIVEN_PG_BASE=defaultdb
AIVEN_PG_USUARIO=avnadmin
AIVEN_PG_CONTRASENA=

# ---- Acceso público temporal con ngrok (opcional, perfil "publico") ----
# Token de https://dashboard.ngrok.com/get-started/your-authtoken (no se versiona).
NGROK_AUTHTOKEN=
